# Catalogue behaviour: preview shows review products; strict shows only approved/published rows.
CATALOG_MODE=preview

# Google Drive Excel source. The file must be shared with the service-account email.
GOOGLE_DRIVE_FILE_ID=1L77Mr15E1oEAPIRMt8UzqhryemufLtBE
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Enquiry delivery
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL="ArtLoka Website <website@your-verified-domain.com>"

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional daily redeploy hook for catalogue refresh
VERCEL_DEPLOY_HOOK_URL=
CRON_SECRET=
